    <!-- Battery help -->
    <string name="battery_title">Battery help</string>
    <string name="battery_lead">Rainfold plays through a media service that Android keeps running while sound is on. Some phones still stop it to save battery.</string>
    <string name="battery_step_1">Open the battery optimisation list below and set Rainfold to Not optimised or Unrestricted.</string>
    <string name="battery_step_2">On Samsung phones, also remove Rainfold from Sleeping apps and Deep sleeping apps under Battery, Background usage limits.</string>
    <string name="battery_step_3">On Xiaomi, Oppo, Vivo and OnePlus phones, allow Rainfold to auto-start and run in the background in the app\'s battery settings.</string>
    <string name="battery_open">Open battery optimisation list</string>
    <string name="battery_fallback">Open App info and set Battery to Unrestricted.</string>
    <string name="battery_open_app_info">Open App info</string>

    <!-- Licences and privacy -->
    <string name="licences_title">Licences</string>
    <string name="licences_sounds_title">Sounds</string>
    <string name="licences_sounds_body">Every sound in Rainfold is synthesised on the phone as it plays. No recordings are bundled and nothing is downloaded.</string>
    <string name="licences_fonts_title">Fonts</string>
    <string name="licences_bricolage">Bricolage Grotesque. Copyright 2022 The Bricolage Grotesque Project Authors. Licensed under the SIL Open Font License, Version 1.1.</string>
    <string name="licences_figtree">Figtree. Copyright 2022 The Figtree Project Authors. Licensed under the SIL Open Font License, Version 1.1.</string>
    <string name="licences_libraries_title">Libraries</string>
    <string name="licences_libraries_body">Android Jetpack (Compose, Room, DataStore, Media3, Navigation), Kotlin and kotlinx libraries, and the Google Play Billing Library, under the Apache License 2.0 or the Android Software Development Kit License.</string>
    <string name="licences_ofl_note">The full SIL Open Font License text ships with the source code and is available at openfontlicense.org.</string>
    <string name="privacy_title">Privacy</string>
    <string name="privacy_lead">Rainfold collects nothing and sends nothing. It has no internet permission, no account, no ads and no analytics.</string>
    <string name="privacy_stored">Your mixes, the sound on Listen and your settings are stored on this phone. Export mixes writes them to a file you choose; uninstalling the app or clearing its storage deletes them.</string>
    <string name="privacy_purchases">The one optional purchase is made in the Google Play Store app under Google\'s terms. Rainfold only asks Google Play whether this Google account owns the unlock, keeps that answer on the phone and sends nothing.</string>
    <string name="privacy_permissions_title">Permissions</string>
    <string name="privacy_perm_fgs">Foreground service and media playback: keep sound playing with the screen off.</string>
    <string name="privacy_perm_wake">Wake lock: holds the processor awake only while sound plays.</string>
    <string name="privacy_perm_billing">com.android.vending.BILLING: lets the app ask the Google Play Store app to sell and confirm the one-time unlock.</string>

