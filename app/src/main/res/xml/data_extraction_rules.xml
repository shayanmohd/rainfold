<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- The unlock is read back from Google Play on the new phone, never copied from the old one. -->
    <cloud-backup>
        <exclude domain="file" path="datastore/entitlement.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/entitlement.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
